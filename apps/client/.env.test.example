# Copy to .env.test.local and fill in from `supabase start`'s output (run from the repo root).
# These values are deterministic for this repo's checked-in supabase/config.toml, so every
# developer's local Supabase instance prints the same ones.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key — used only by integration tests to inspect DB state directly, never by
# shipped app code.
SUPABASE_TEST_SECRET_KEY=
# Mailpit's REST API, used by integration tests to read confirmation/reset emails.
SUPABASE_TEST_MAILPIT_URL=
